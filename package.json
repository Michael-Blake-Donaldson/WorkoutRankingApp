{
  "name": "fitness-rpg",
  "version": "0.1.0",
  "description": "Private two-user fitness PWA combining serious training, RPG progression, guided adaptation, head-to-head competition, and basic nutrition.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . --error-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "invite": "tsx scripts/invite.ts",
    "auth:revoke": "tsx scripts/revoke-sessions.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "biome check --write .",
    "test:prepare": "tsx scripts/prepare-test-db.ts integration",
    "test:e2e:prepare": "tsx scripts/prepare-test-db.ts e2e",
    "db:runtime": "tsx scripts/local-runtime-role.ts",
    "auth:cleanup": "tsx scripts/cleanup-auth.ts",
    "test:cert": "node scripts/local-cert.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "selfsigned": "5.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
