generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                    @id
  name                 String
  email                String                    @unique
  emailVerified        Boolean                   @default(false)
  image                String?
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  slot                 Int                       @unique @default(0)
  sessions             Session[]
  accounts             Account[]
  fitnessProfile       FitnessProfile?
  bodyMeasurements     BodyMeasurement[]
  equipmentProfiles    EquipmentProfile[]
  profileRevisions     ProfileRevision[]
  profileMutations     ProfileMutation[]
  exerciseRestrictions UserExerciseRestriction[]
  exerciseChoices      UserExerciseChoice[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("verifications")
}

model Invitation {
  id        String    @id @default(uuid())
  email     String    @unique
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@map("invitations")
}

model Capacity {
  id       Int @id
  occupied Int @default(0)

  @@map("account_capacity")
}

model RequestBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("request_buckets")
}

model AuditEvent {
  id        String   @id @default(uuid())
  eventType String
  entityId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
  @@map("audit_events")
}

model FitnessProfile {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version                 Int       @default(1)
  displayName             String
  experience              String
  primaryGoal             String
  secondaryGoals          String[]
  trainingDays            Int[]
  durationMinutes         Int
  timezone                String
  likes                   String    @default("")
  dislikes                String    @default("")
  limitations             String    @default("")
  movementFiltersReviewed Boolean   @default(false)
  heightCm                Decimal?  @db.Decimal(10, 3)
  calorieTarget           Decimal?  @db.Decimal(10, 2)
  proteinTargetG          Decimal?  @db.Decimal(10, 2)
  weightUnit              String    @default("kg")
  lengthUnit              String    @default("cm")
  shareCompetitionSummary Boolean   @default(false)
  audioEnabled            Boolean   @default(false)
  hapticsEnabled          Boolean   @default(false)
  motionPreference        String    @default("system")
  onboardingCompletedAt   DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  @@map("fitness_profiles")
}

model Muscle {
  id        String           @id
  name      String
  category  String
  exercises ExerciseMuscle[]

  @@map("muscles")
}

model Exercise {
  id           String               @id
  slug         String               @unique
  variantGroup String
  archived     Boolean              @default(false)
  versions     ExerciseVersion[]
  choices      UserExerciseChoice[]

  @@map("exercises")
}

model ExerciseVersion {
  id           String              @id
  exerciseId   String
  exercise     Exercise            @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  version      Int
  name         String
  aliases      String[]
  modality     String
  pattern      String
  laterality   String
  resistance   String
  difficulty   Int
  metrics      String[]
  demands      String[]
  instructions String[]
  safetyNotes  String[]
  sourceUrls   String[]
  license      String
  reviewedBy   String
  reviewedAt   DateTime            @db.Timestamptz(3)
  contentHash  String
  reviewStatus String
  muscles      ExerciseMuscle[]
  equipment    ExerciseEquipment[]

  @@unique([exerciseId, version])
  @@index([reviewStatus, name])
  @@map("exercise_versions")
}

model ExerciseMuscle {
  exerciseVersionId String
  version           ExerciseVersion @relation(fields: [exerciseVersionId], references: [id], onDelete: Restrict)
  muscleId          String
  muscle            Muscle          @relation(fields: [muscleId], references: [id], onDelete: Restrict)
  role              String

  @@id([exerciseVersionId, muscleId])
  @@map("exercise_muscles")
}

model ExerciseEquipment {
  exerciseVersionId String
  version           ExerciseVersion @relation(fields: [exerciseVersionId], references: [id], onDelete: Restrict)
  equipmentType     String

  @@id([exerciseVersionId, equipmentType])
  @@map("exercise_equipment")
}

model UserExerciseRestriction {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String

  @@id([userId, code])
  @@map("user_exercise_restrictions")
}

model UserExerciseChoice {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  preference String

  @@id([userId, exerciseId])
  @@map("user_exercise_choices")
}

model BodyMeasurement {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric           String
  valueSi          Decimal           @db.Decimal(12, 6)
  recordedAt       DateTime          @db.Timestamptz(3)
  source           String            @default("manual")
  correctsId       String?           @unique
  corrects         BodyMeasurement?  @relation("MeasurementCorrection", fields: [correctsId, userId, metric], references: [id, userId, metric], onDelete: NoAction, onUpdate: NoAction)
  correctedBy      BodyMeasurement[] @relation("MeasurementCorrection")
  correctionReason String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([id, userId, metric])
  @@index([userId, recordedAt])
  @@map("body_measurements")
}

model EquipmentProfile {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  location   String
  isDefault  Boolean         @default(false)
  archivedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  items      EquipmentItem[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("equipment_profiles")
}

model EquipmentItem {
  id            String           @id @default(uuid())
  profileId     String
  userId        String
  profile       EquipmentProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  equipmentType String
  minLoadKg     Decimal?         @db.Decimal(10, 3)
  maxLoadKg     Decimal?         @db.Decimal(10, 3)
  incrementKg   Decimal?         @db.Decimal(10, 3)

  @@unique([profileId, equipmentType])
  @@index([userId, profileId])
  @@map("equipment_items")
}

model ProfileRevision {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      Int
  snapshotJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, version])
  @@map("profile_revisions")
}

model ProfileMutation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientMutationId String
  payloadHash      String
  appliedVersion   Int
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, clientMutationId])
  @@map("profile_mutations")
}
