generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  slot              Int                @unique @default(0)
  sessions          Session[]
  accounts          Account[]
  fitnessProfile    FitnessProfile?
  bodyMeasurements  BodyMeasurement[]
  equipmentProfiles EquipmentProfile[]
  profileRevisions  ProfileRevision[]
  profileMutations  ProfileMutation[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("verifications")
}

model Invitation {
  id        String    @id @default(uuid())
  email     String    @unique
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@map("invitations")
}

model Capacity {
  id       Int @id
  occupied Int @default(0)

  @@map("account_capacity")
}

model RequestBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("request_buckets")
}

model AuditEvent {
  id        String   @id @default(uuid())
  eventType String
  entityId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
  @@map("audit_events")
}

model FitnessProfile {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version                 Int       @default(1)
  displayName             String
  experience              String
  primaryGoal             String
  secondaryGoals          String[]
  trainingDays            Int[]
  durationMinutes         Int
  timezone                String
  likes                   String    @default("")
  dislikes                String    @default("")
  limitations             String    @default("")
  heightCm                Decimal?  @db.Decimal(10, 3)
  calorieTarget           Decimal?  @db.Decimal(10, 2)
  proteinTargetG          Decimal?  @db.Decimal(10, 2)
  weightUnit              String    @default("kg")
  lengthUnit              String    @default("cm")
  shareCompetitionSummary Boolean   @default(false)
  audioEnabled            Boolean   @default(false)
  hapticsEnabled          Boolean   @default(false)
  motionPreference        String    @default("system")
  onboardingCompletedAt   DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  @@map("fitness_profiles")
}

model BodyMeasurement {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric           String
  valueSi          Decimal           @db.Decimal(12, 6)
  recordedAt       DateTime          @db.Timestamptz(3)
  source           String            @default("manual")
  correctsId       String?           @unique
  corrects         BodyMeasurement?  @relation("MeasurementCorrection", fields: [correctsId, userId, metric], references: [id, userId, metric], onDelete: NoAction, onUpdate: NoAction)
  correctedBy      BodyMeasurement[] @relation("MeasurementCorrection")
  correctionReason String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([id, userId, metric])
  @@index([userId, recordedAt])
  @@map("body_measurements")
}

model EquipmentProfile {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  location   String
  isDefault  Boolean         @default(false)
  archivedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  items      EquipmentItem[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("equipment_profiles")
}

model EquipmentItem {
  id            String           @id @default(uuid())
  profileId     String
  userId        String
  profile       EquipmentProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  equipmentType String
  minLoadKg     Decimal?         @db.Decimal(10, 3)
  maxLoadKg     Decimal?         @db.Decimal(10, 3)
  incrementKg   Decimal?         @db.Decimal(10, 3)

  @@unique([profileId, equipmentType])
  @@index([userId, profileId])
  @@map("equipment_items")
}

model ProfileRevision {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      Int
  snapshotJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, version])
  @@map("profile_revisions")
}

model ProfileMutation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientMutationId String
  payloadHash      String
  appliedVersion   Int
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, clientMutationId])
  @@map("profile_mutations")
}
